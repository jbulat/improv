{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://improv.local/schema/troupe.schema.json",
  "title": "Troupe",
  "description": "The casting catalog: the fixed six actors, the MC, their expression sets, the sanctioned sfx vocabulary, and the voice catalog. Read by the validator, the build, and the future Director (schema_version 1).",
  "type": "object",
  "required": ["schema_version", "actors", "mc", "expressions", "layers", "sfx_vocabulary", "sfx_catalog", "voices"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "voice"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "category": { "enum": ["human", "animal"] },
          "voice": { "type": "string", "minLength": 1 }
        }
      }
    },
    "mc": {
      "type": "object",
      "required": ["id", "name", "voice"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "voice": { "type": "string", "minLength": 1 }
      }
    },
    "expressions": {
      "type": "object",
      "required": ["base", "miss_moon"],
      "additionalProperties": false,
      "properties": {
        "base": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "miss_moon": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "layers": {
      "description": "The shared paper-doll layer catalog: every layer id a director may cast, its slot, and which actors it fits (actor ids and/or categories). Sprite anchor offsets live with the art, not here.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "slot", "fits", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z_]*$" },
          "slot": { "enum": ["back_prop", "costume", "headwear", "front_prop"] },
          "fits": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sfx_vocabulary": {
      "type": "array",
      "items": { "type": "string", "pattern": "^sfx_[a-z_]+$" }
    },
    "sfx_catalog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "sound", "use", "avoid"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^sfx_[a-z_]+$" },
          "sound": { "type": "string", "minLength": 1 },
          "use": { "type": "string", "minLength": 1 },
          "avoid": { "type": "string", "minLength": 1 }
        }
      }
    },
    "voices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
