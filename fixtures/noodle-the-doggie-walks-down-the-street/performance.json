  "timeline": [
    {
      "index": 0,
      "character_id": "miss_moon",
      "expression": "happy",
      "text": "Noodle the doggie lived in the house on Oak Tree Lane.",
      "line_audio": "aud_000",
      "sfx": [
        {
          "audio": "sfx_chime",
          "at_ms": 340
        }
      ],
      "duration_ms": 3180,
      "animation": "speak"
    },
    {
      "index": 1,
      "character_id": "miss_moon",
      "expression": "curious",
      "text": "Early one summer morning, he smelled sausages down in the village.",
      "line_audio": "aud_001",
      "sfx": [],
      "duration_ms": 4136,
      "animation": "speak"
    },
    {
      "index": 2,
      "character_id": "noodle",
      "expression": "happy",
      "text": "Sniff, sniff... sausages! Down the street I go!",
      "line_audio": "aud_002",
      "sfx": [
        {
          "audio": "sfx_bark",
          "at_ms": 130
        }
      ],
      "duration_ms": 3120,
      "animation": "speak"
    },
    {
      "index": 3,
      "character_id": "miss_moon",
      "expression": "surprised",
      "text": "But the shops weren't open yet — all except one. The sausage shop's door was left open!",
      "line_audio": "aud_003",
      "sfx": [],
      "duration_ms": 5980,
      "animation": "speak"
    },
    {
      "index": 4,
      "character_id": "noodle",
      "expression": "surprised",
      "text": "Ooh! Just one little sausage. Just for me.",
      "line_audio": "aud_004",
      "sfx": [],
      "duration_ms": 2730,
      "animation": "speak"
    },
    {
      "index": 5,
      "character_id": "shopkeeper",
      "expression": "angry",
      "text": "Hey! That's my sausage! Come back here, dog!",
      "line_audio": "aud_005",
      "sfx": [],
      "duration_ms": 3500,
      "animation": "speak"
    },
    {
      "index": 6,
      "character_id": "miss_moon",
      "expression": "surprised",
      "text": "And off went the shopkeeper, running after Noodle down the street.",
      "line_audio": "aud_006",
      "sfx": [
        {
          "audio": "sfx_whoosh",
          "at_ms": 230
        }
      ],
      "duration_ms": 3840,
      "animation": "speak"
    },
    {
      "index": 7,
      "character_id": "miss_moon",
      "expression": "sad",
      "text": "Back on Oak Tree Lane, Hattie woke up. Noodle's basket was empty.",
      "line_audio": "aud_007",
      "sfx": [],
      "duration_ms": 4440,
      "animation": "speak"
    },
    {
      "index": 8,
      "character_id": "hattie",
      "expression": "sad",
      "text": "Noodle? Noodle, where are you?",
      "line_audio": "aud_008",
      "sfx": [],
      "duration_ms": 1980,
      "animation": "speak"
    },
    {
      "index": 9,
      "character_id": "miss_moon",
      "expression": "surprised",
      "text": "She ran to the village — and saw her dog being chased!",
      "line_audio": "aud_009",
      "sfx": [],
      "duration_ms": 3390,
      "animation": "speak"
    },
    {
      "index": 10,
      "character_id": "hattie",
      "expression": "surprised",
      "text": "NOODLE!",
      "line_audio": "aud_010",
      "sfx": [],
      "duration_ms": 970,
      "animation": "speak"
    },
    {
      "index": 11,
      "character_id": "miss_moon",
      "expression": "happy",
      "text": "Noodle heard his name and ran straight to his girl.",
      "line_audio": "aud_011",
      "sfx": [
        {
          "audio": "sfx_bark",
          "at_ms": 2260
        }
      ],
      "duration_ms": 3260,
      "animation": "speak"
    },
    {
      "index": 12,
      "character_id": "shopkeeper",
      "expression": "angry",
      "text": "Stop! You two, stop right there!",
      "line_audio": "aud_012",
      "sfx": [],
      "duration_ms": 2700,
      "animation": "speak"
    },
    {
      "index": 13,
      "character_id": "hattie",
      "expression": "scared",
      "text": "Quick, Noodle — behind the fountain. Shhh!",
      "line_audio": "aud_013",
      "sfx": [],
      "duration_ms": 3130,
      "animation": "speak"
    },
    {
      "index": 14,
      "character_id": "miss_moon",
      "expression": "giggling",
      "text": "They hid behind the fountain and kept very, very still.",
      "line_audio": "aud_014",
      "sfx": [],
      "duration_ms": 3590,
      "animation": "speak"
    },
    {
      "index": 15,
      "character_id": "miss_moon",
      "expression": "delighted",
      "text": "The shopkeeper puffed straight past, and never looked back.",
      "line_audio": "aud_015",
      "sfx": [],
      "duration_ms": 3400,
      "animation": "speak"
    },
    {
      "index": 16,
      "character_id": "noodle",
      "expression": "happy",
      "text": "Woof! We did it. And I still have my sausage.",
      "line_audio": "aud_016",
      "sfx": [
        {
          "audio": "sfx_bark",
          "at_ms": 110
        }
      ],
      "duration_ms": 3057,
      "animation": "speak"
    },
    {
      "index": 17,
      "character_id": "miss_moon",
      "expression": "delighted",
      "text": "So Hattie and Noodle walked home, happily ever after. The end.",
      "line_audio": "aud_017",
      "sfx": [
        {
          "audio": "sfx_chime",
          "at_ms": 1960
        }
      ],
      "duration_ms": 4180,
      "animation": "speak"
    }
  ],
