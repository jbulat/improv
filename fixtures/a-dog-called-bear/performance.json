  "timeline": [
    {
      "index": 0,
      "character_id": "miss_moon",
      "expression": "delighted",
      "text": "Gather in, gather in! Tonight, a girl a long way from home.",
      "line_audio": "aud_000",
      "sfx": [
        {
          "audio": "sfx_sparkle",
          "at_ms": 220
        }
      ],
      "duration_ms": 4030,
      "animation": "speak"
    },
    {
      "index": 1,
      "character_id": "miss_moon",
      "expression": "curious",
      "text": "One day there was a girl called Marisol, and she lived in America.",
      "line_audio": "aud_001",
      "sfx": [],
      "duration_ms": 4010,
      "animation": "speak"
    },
    {
      "index": 2,
      "character_id": "miss_moon",
      "expression": "surprised",
      "text": "Then she moved to England. Everything was different.",
      "line_audio": "aud_002",
      "sfx": [
        {
          "audio": "sfx_whoosh",
          "at_ms": 290
        }
      ],
      "duration_ms": 3190,
      "animation": "speak"
    },
    {
      "index": 3,
      "character_id": "marisol",
      "expression": "sad",
      "text": "Grey sky. Strange words. And nobody here says my name right.",
      "line_audio": "aud_003",
      "sfx": [],
      "duration_ms": 3970,
      "animation": "speak"
    },
    {
      "index": 4,
      "character_id": "miss_moon",
      "expression": "sad",
      "text": "She had no one to play with. And then a little girl came over.",
      "line_audio": "aud_004",
      "sfx": [],
      "duration_ms": 3620,
      "animation": "speak"
    },
    {
      "index": 5,
      "character_id": "marisol",
      "expression": "surprised",
      "text": "May we play together?",
      "line_audio": "aud_005",
      "sfx": [],
      "duration_ms": 1630,
      "animation": "speak"
    },
    {
      "index": 6,
      "character_id": "poppy",
      "expression": "happy",
      "text": "Yes! You're it, Marisol. Catch me if you can!",
      "line_audio": "aud_006",
      "sfx": [
        {
          "audio": "sfx_whoosh",
          "at_ms": 1030
        }
      ],
      "duration_ms": 2670,
      "animation": "speak"
    },
    {
      "index": 7,
      "character_id": "poppy",
      "expression": "neutral",
      "text": "That was so fun. But I have to go home now. Bye!",
      "line_audio": "aud_007",
      "sfx": [],
      "duration_ms": 3290,
      "animation": "speak"
    },
    {
      "index": 8,
      "character_id": "marisol",
      "expression": "sad",
      "text": "And then I had nobody again.",
      "line_audio": "aud_008",
      "sfx": [],
      "duration_ms": 2110,
      "animation": "speak"
    },
    {
      "index": 9,
      "character_id": "dad",
      "expression": "sad",
      "text": "I know, love. A new place takes a little time.",
      "line_audio": "aud_009",
      "sfx": [],
      "duration_ms": 2970,
      "animation": "speak"
    },
    {
      "index": 10,
      "character_id": "dad",
      "expression": "happy",
      "text": "Come on. Put your shoes on. We're going to the pet store.",
      "line_audio": "aud_010",
      "sfx": [],
      "duration_ms": 3120,
      "animation": "speak"
    },
    {
      "index": 11,
      "character_id": "bear",
      "expression": "happy",
      "text": "Woof! Woof! Hello! Are you my girl?",
      "line_audio": "aud_011",
      "sfx": [
        {
          "audio": "sfx_bark",
          "at_ms": 90
        }
      ],
      "duration_ms": 2425,
      "animation": "speak"
    },
    {
      "index": 12,
      "character_id": "marisol",
      "expression": "happy",
      "text": "This is Bear. He's brown and fluffy. He played with me every day.",
      "line_audio": "aud_012",
      "sfx": [],
      "duration_ms": 3870,
      "animation": "speak"
    },
    {
      "index": 13,
      "character_id": "marisol",
      "expression": "happy",
      "text": "Everyone came to meet Bear. Then they came to meet me.",
      "line_audio": "aud_013",
      "sfx": [],
      "duration_ms": 3140,
      "animation": "speak"
    },
    {
      "index": 14,
      "character_id": "poppy",
      "expression": "happy",
      "text": "Marisol! Marisol! Can Bear play chase with all of us?",
      "line_audio": "aud_014",
      "sfx": [],
      "duration_ms": 3420,
      "animation": "speak"
    },
    {
      "index": 15,
      "character_id": "miss_moon",
      "expression": "delighted",
      "text": "She got more friends, and more friends, and more friends.",
      "line_audio": "aud_015",
      "sfx": [],
      "duration_ms": 3480,
      "animation": "speak"
    },
    {
      "index": 16,
      "character_id": "miss_moon",
      "expression": "happy",
      "text": "And Marisol lived happily ever after.",
      "line_audio": "aud_016",
      "sfx": [
        {
          "audio": "sfx_chime",
          "at_ms": 890
        }
      ],
      "duration_ms": 2800,
      "animation": "speak"
    }
  ],
