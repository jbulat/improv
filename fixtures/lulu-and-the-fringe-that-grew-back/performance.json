  "timeline": [
    {
      "index": 0,
      "character_id": "miss_moon",
      "expression": "neutral",
      "text": "Once upon a time there was a girl called Lulu, who had a really long fringe.",
      "line_audio": "aud_000",
      "sfx": [],
      "duration_ms": 4838,
      "animation": "speak"
    },
    {
      "index": 1,
      "character_id": "lulu",
      "expression": "sad",
      "text": "My fringe is so long I can't see where I'm going!",
      "line_audio": "aud_001",
      "sfx": [],
      "duration_ms": 2870,
      "animation": "speak"
    },
    {
      "index": 2,
      "character_id": "miss_moon",
      "expression": "curious",
      "text": "So Lulu took her scissors and went snip, snip, snip.",
      "line_audio": "aud_002",
      "sfx": [
        {
          "audio": "sfx_shing",
          "at_ms": 2110
        }
      ],
      "duration_ms": 3240,
      "animation": "speak"
    },
    {
      "index": 3,
      "character_id": "lulu",
      "expression": "surprised",
      "text": "It grew back! Even longer than before!",
      "line_audio": "aud_003",
      "sfx": [
        {
          "audio": "sfx_sparkle",
          "at_ms": 260
        }
      ],
      "duration_ms": 2460,
      "animation": "speak"
    },
    {
      "index": 4,
      "character_id": "miss_moon",
      "expression": "surprised",
      "text": "She cut it again. And again. And every time, it grew right back.",
      "line_audio": "aud_004",
      "sfx": [
        {
          "audio": "sfx_shing",
          "at_ms": 980
        }
      ],
      "duration_ms": 4380,
      "animation": "speak"
    },
    {
      "index": 5,
      "character_id": "lulu",
      "expression": "sad",
      "text": "I will never, ever be rid of this fringe.",
      "line_audio": "aud_005",
      "sfx": [],
      "duration_ms": 2600,
      "animation": "speak"
    },
    {
      "index": 6,
      "character_id": "miss_moon",
      "expression": "curious",
      "text": "So Lulu went to find the magical witch who lived in the woods.",
      "line_audio": "aud_006",
      "sfx": [],
      "duration_ms": 3700,
      "animation": "speak"
    },
    {
      "index": 7,
      "character_id": "witch",
      "expression": "neutral",
      "text": "A fringe that grows back? Oh, I know just the spell.",
      "line_audio": "aud_007",
      "sfx": [],
      "duration_ms": 3120,
      "animation": "speak"
    },
    {
      "index": 8,
      "character_id": "witch",
      "expression": "happy",
      "text": "Higgledy, piggledy... BALD!",
      "line_audio": "aud_008",
      "sfx": [
        {
          "audio": "sfx_sparkle",
          "at_ms": 1110
        }
      ],
      "duration_ms": 1960,
      "animation": "speak"
    },
    {
      "index": 9,
      "character_id": "miss_moon",
      "expression": "surprised",
      "text": "And poof! Every single hair was gone.",
      "line_audio": "aud_009",
      "sfx": [],
      "duration_ms": 2510,
      "animation": "speak"
    },
    {
      "index": 10,
      "character_id": "lulu",
      "expression": "surprised",
      "layers": {
        "headwear": null
      },
      "text": "Ooh! My head is as shiny as a marble!",
      "line_audio": "aud_010",
      "sfx": [],
      "duration_ms": 2370,
      "animation": "speak"
    },
    {
      "index": 11,
      "character_id": "miss_moon",
      "expression": "happy",
      "text": "Then slowly, slowly, her hair started growing back.",
      "line_audio": "aud_011",
      "sfx": [
        {
          "audio": "sfx_sparkle",
          "at_ms": 2320
        }
      ],
      "duration_ms": 3400,
      "animation": "speak"
    },
    {
      "index": 12,
      "character_id": "miss_moon",
      "expression": "delighted",
      "text": "It grew and grew and grew, and the fringe never came back!",
      "line_audio": "aud_012",
      "sfx": [],
      "duration_ms": 3640,
      "animation": "speak"
    },
    {
      "index": 13,
      "character_id": "lulu",
      "expression": "happy",
      "layers": {
        "headwear": null
      },
      "text": "My hair is really, really, REALLY long!",
      "line_audio": "aud_013",
      "sfx": [],
      "duration_ms": 2770,
      "animation": "speak"
    },
    {
      "index": 14,
      "character_id": "miss_moon",
      "expression": "giggling",
      "text": "So long that Lulu still needed every single one of her clips.",
      "line_audio": "aud_014",
      "sfx": [],
      "duration_ms": 3900,
      "animation": "speak"
    },
    {
      "index": 15,
      "character_id": "lulu",
      "expression": "happy",
      "layers": {
        "headwear": null
      },
      "text": "One clip. Two clips. Ten clips! Perfect.",
      "line_audio": "aud_015",
      "sfx": [],
      "duration_ms": 2700,
      "animation": "speak"
    },
    {
      "index": 16,
      "character_id": "miss_moon",
      "expression": "delighted",
      "text": "And Lulu never needed scissors again. The end.",
      "line_audio": "aud_016",
      "sfx": [
        {
          "audio": "sfx_chime",
          "at_ms": 1780
        }
      ],
      "duration_ms": 3190,
      "animation": "speak"
    }
  ],
