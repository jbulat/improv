  "timeline": [
    {
      "index": 0,
      "character_id": "miss_moon",
      "expression": "delighted",
      "text": "Once upon a time there was a dragon who was very bad at being mean.",
      "line_audio": "aud_000",
      "sfx": [
        {
          "audio": "sfx_sparkle",
          "at_ms": 0
        }
      ],
      "duration_ms": 4400,
      "animation": "speak"
    },
    {
      "index": 1,
      "character_id": "wilfred",
      "expression": "neutral",
      "text": "I am Wilfred. I guard Princess Mia's tower. Fiercely. Terribly fiercely.",
      "line_audio": "aud_001",
      "sfx": [],
      "duration_ms": 4880,
      "animation": "speak"
    },
    {
      "index": 2,
      "character_id": "wilfred",
      "expression": "neutral",
      "text": "Like this. Ahem.",
      "line_audio": "aud_002",
      "sfx": [],
      "duration_ms": 1810,
      "animation": "speak"
    },
    {
      "index": 3,
      "character_id": "wilfred",
      "expression": "angry",
      "text": "RAAAWR!",
      "line_audio": "aud_015",
      "sfx": [
        {
          "audio": "sfx_roar",
          "at_ms": 0
        },
        {
          "audio": "sfx_fire",
          "at_ms": 0
        }
      ],
      "duration_ms": 1060,
      "animation": "speak",
      "layers": {
        "front_prop": "fire"
      }
    },
    {
      "index": 4,
      "character_id": "wilfred",
      "expression": "sad",
      "text": "Oh dear. Was that too loud? I'm sorry.",
      "line_audio": "aud_016",
      "sfx": [],
      "duration_ms": 2890,
      "animation": "speak"
    },
    {
      "index": 5,
      "character_id": "mia",
      "expression": "happy",
      "text": "Wilfred, that is the politest roar I have ever heard.",
      "line_audio": "aud_003",
      "sfx": [],
      "duration_ms": 3250,
      "animation": "speak"
    },
    {
      "index": 6,
      "character_id": "wilfred",
      "expression": "sad",
      "text": "I don't want to be a mean dragon. I want to be a dog.",
      "line_audio": "aud_004",
      "sfx": [],
      "duration_ms": 3350,
      "animation": "speak"
    },
    {
      "index": 7,
      "character_id": "mia",
      "expression": "surprised",
      "text": "A dog? Well, I could try a spell. But first, go and meet one.",
      "line_audio": "aud_005",
      "sfx": [],
      "duration_ms": 3560,
      "animation": "speak"
    },
    {
      "index": 8,
      "character_id": "miss_moon",
      "expression": "curious",
      "text": "So Wilfred flew over the hills to find his pen pal, Bob.",
      "line_audio": "aud_006",
      "sfx": [
        {
          "audio": "sfx_whoosh",
          "at_ms": 890
        }
      ],
      "duration_ms": 3830,
      "animation": "speak"
    },
    {
      "index": 9,
      "character_id": "bob",
      "expression": "happy",
      "text": "WILFRED! My favourite pen pal! You are much bigger than your letters said!",
      "line_audio": "aud_007",
      "sfx": [
        {
          "audio": "sfx_bark",
          "at_ms": 0
        }
      ],
      "duration_ms": 4190,
      "animation": "speak"
    },
    {
      "index": 10,
      "character_id": "wilfred",
      "expression": "happy",
      "text": "Teach me to be a dog, Bob. Look! I'm wagging! Am I wagging?",
      "line_audio": "aud_008",
      "sfx": [],
      "duration_ms": 3960,
      "animation": "speak"
    },
    {
      "index": 11,
      "character_id": "wilfred",
      "expression": "happy",
      "text": "And now my very best woof.",
      "line_audio": "aud_009",
      "sfx": [],
      "duration_ms": 2220,
      "animation": "speak"
    },
    {
      "index": 12,
      "character_id": "wilfred",
      "expression": "surprised",
      "text": "WOOF.",
      "line_audio": "aud_017",
      "sfx": [
        {
          "audio": "sfx_fire",
          "at_ms": 0
        }
      ],
      "duration_ms": 1040,
      "animation": "speak",
      "layers": {
        "front_prop": "fire"
      }
    },
    {
      "index": 13,
      "character_id": "wilfred",
      "expression": "sad",
      "text": "Oh. That was fire again.",
      "line_audio": "aud_018",
      "sfx": [],
      "duration_ms": 2110,
      "animation": "speak"
    },
    {
      "index": 14,
      "character_id": "bob",
      "expression": "happy",
      "text": "Wilfred, nobody is a better dog than me. And nobody is a better Wilfred than you.",
      "line_audio": "aud_010",
      "sfx": [],
      "duration_ms": 4990,
      "animation": "speak"
    },
    {
      "index": 15,
      "character_id": "miss_moon",
      "expression": "happy",
      "text": "And Wilfred thought about that the whole long way home.",
      "line_audio": "aud_011",
      "sfx": [],
      "duration_ms": 3070,
      "animation": "speak"
    },
    {
      "index": 16,
      "character_id": "mia",
      "expression": "neutral",
      "layers": {
        "front_prop": "wand"
      },
      "text": "There you are! Ready? One little dog, coming right up!",
      "line_audio": "aud_012",
      "sfx": [
        {
          "audio": "sfx_sparkle",
          "at_ms": 2020
        }
      ],
      "duration_ms": 3010,
      "animation": "speak"
    },
    {
      "index": 17,
      "character_id": "wilfred",
      "expression": "happy",
      "text": "No thank you, Mia. I would rather stay a friendly dragon.",
      "line_audio": "aud_013",
      "sfx": [],
      "duration_ms": 3710,
      "animation": "speak"
    },
    {
      "index": 18,
      "character_id": "miss_moon",
      "expression": "delighted",
      "text": "And Mia said a friendly dragon was exactly what her tower needed. The end!",
      "line_audio": "aud_014",
      "sfx": [
        {
          "audio": "sfx_chime",
          "at_ms": 3370
        }
      ],
      "duration_ms": 4890,
      "animation": "speak"
    }
  ],
