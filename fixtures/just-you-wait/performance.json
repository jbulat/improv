  "timeline": [
    {
      "index": 0,
      "character_id": "miss_moon",
      "expression": "happy",
      "text": "On a green leaf lived a caterpillar, munching all day long.",
      "line_audio": "aud_000",
      "sfx": [
        {
          "audio": "sfx_chime",
          "at_ms": 200
        }
      ],
      "duration_ms": 3730,
      "animation": "speak"
    },
    {
      "index": 1,
      "character_id": "caterpillar",
      "expression": "happy",
      "text": "Good morning, sunshine! Good morning, leaf! What a lovely day.",
      "line_audio": "aud_001",
      "sfx": [],
      "duration_ms": 3490,
      "animation": "speak"
    },
    {
      "index": 2,
      "character_id": "ladybug",
      "expression": "happy",
      "text": "You are *so* ugly. Because you're a caterpillar.",
      "line_audio": "aud_002",
      "sfx": [
        {
          "audio": "sfx_squeak",
          "at_ms": 120
        }
      ],
      "duration_ms": 2530,
      "animation": "speak"
    },
    {
      "index": 3,
      "character_id": "caterpillar",
      "expression": "neutral",
      "text": "Just you wait. I'll be beautiful.",
      "line_audio": "aud_003",
      "sfx": [],
      "duration_ms": 2080,
      "animation": "speak"
    },
    {
      "index": 4,
      "character_id": "ladybug",
      "expression": "happy",
      "text": "No you won't! Let's make a bet.",
      "line_audio": "aud_004",
      "sfx": [],
      "duration_ms": 1897,
      "animation": "speak"
    },
    {
      "index": 5,
      "character_id": "ladybug",
      "expression": "happy",
      "text": "If you're not beautiful in two days, you have to leave.",
      "line_audio": "aud_005",
      "sfx": [],
      "duration_ms": 2810,
      "animation": "speak"
    },
    {
      "index": 6,
      "character_id": "ladybug",
      "expression": "neutral",
      "text": "And if you are... I'll have to leave.",
      "line_audio": "aud_006",
      "sfx": [],
      "duration_ms": 1870,
      "animation": "speak"
    },
    {
      "index": 7,
      "character_id": "caterpillar",
      "expression": "happy",
      "text": "Deal.",
      "line_audio": "aud_007",
      "sfx": [],
      "duration_ms": 950,
      "animation": "speak"
    },
    {
      "index": 8,
      "character_id": "miss_moon",
      "expression": "curious",
      "text": "The next day, the caterpillar was gone. In her place: a chrysalis.",
      "line_audio": "aud_008",
      "sfx": [],
      "duration_ms": 4380,
      "animation": "speak"
    },
    {
      "index": 9,
      "character_id": "ladybug",
      "expression": "happy",
      "text": "Ha! You're even uglier than you were before!",
      "line_audio": "aud_009",
      "sfx": [
        {
          "audio": "sfx_squeak",
          "at_ms": 110
        }
      ],
      "duration_ms": 2290,
      "animation": "speak"
    },
    {
      "index": 10,
      "character_id": "miss_moon",
      "expression": "neutral",
      "text": "The chrysalis said nothing at all. It just waited.",
      "line_audio": "aud_010",
      "sfx": [],
      "duration_ms": 3110,
      "animation": "speak"
    },
    {
      "index": 11,
      "character_id": "miss_moon",
      "expression": "surprised",
      "text": "And on the second day, the chrysalis was gone too.",
      "line_audio": "aud_011",
      "sfx": [
        {
          "audio": "sfx_sparkle",
          "at_ms": 1430
        }
      ],
      "duration_ms": 3040,
      "animation": "speak"
    },
    {
      "index": 12,
      "character_id": "ladybug",
      "expression": "surprised",
      "text": "Wait - where's the caterpillar?",
      "line_audio": "aud_012",
      "sfx": [],
      "duration_ms": 1578,
      "animation": "speak"
    },
    {
      "index": 13,
      "character_id": "caterpillar",
      "expression": "happy",
      "layers": {
        "headwear": "antennae",
        "back_prop": "wings"
      },
      "text": "I'm right here. I'm beautiful.",
      "line_audio": "aud_013",
      "sfx": [],
      "duration_ms": 2020,
      "animation": "speak"
    },
    {
      "index": 14,
      "character_id": "caterpillar",
      "expression": "happy",
      "layers": {
        "headwear": "antennae",
        "back_prop": "wings"
      },
      "text": "So you have to leave, you mean ladybug.",
      "line_audio": "aud_014",
      "sfx": [],
      "duration_ms": 2450,
      "animation": "speak"
    },
    {
      "index": 15,
      "character_id": "ladybug",
      "expression": "sad",
      "text": "I did say that, didn't I.",
      "line_audio": "aud_015",
      "sfx": [],
      "duration_ms": 1620,
      "animation": "speak"
    },
    {
      "index": 16,
      "character_id": "miss_moon",
      "expression": "happy",
      "text": "Off flew the ladybug, and never called a caterpillar ugly again.",
      "line_audio": "aud_016",
      "sfx": [
        {
          "audio": "sfx_whoosh",
          "at_ms": 410
        },
        {
          "audio": "sfx_chime",
          "at_ms": 2320
        }
      ],
      "duration_ms": 4070,
      "animation": "speak"
    }
  ],
