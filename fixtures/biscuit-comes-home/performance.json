  "timeline": [
    {
      "index": 0,
      "character_id": "miss_moon",
      "expression": "neutral",
      "text": "Once upon a time, a princess had a little dog named Biscuit.",
      "line_audio": "aud_000",
      "sfx": [],
      "duration_ms": 4140,
      "animation": "speak"
    },
    {
      "index": 1,
      "character_id": "princess",
      "expression": "happy",
      "text": "Biscuit! You're the best dog in the whole kingdom.",
      "line_audio": "aud_001",
      "sfx": [
        {
          "audio": "sfx_bark",
          "at_ms": 1720
        }
      ],
      "duration_ms": 2630,
      "animation": "speak"
    },
    {
      "index": 2,
      "character_id": "miss_moon",
      "expression": "sad",
      "text": "But one day, Biscuit was gone. The princess looked everywhere.",
      "line_audio": "aud_002",
      "sfx": [],
      "duration_ms": 3870,
      "animation": "speak"
    },
    {
      "index": 3,
      "character_id": "princess",
      "expression": "sad",
      "text": "Biscuit? Biscuit, where are you?",
      "line_audio": "aud_003",
      "sfx": [],
      "duration_ms": 2080,
      "animation": "speak"
    },
    {
      "index": 4,
      "character_id": "miss_moon",
      "expression": "sad",
      "text": "She went up to her bedroom and cried and cried.",
      "line_audio": "aud_004",
      "sfx": [],
      "duration_ms": 2970,
      "animation": "speak"
    },
    {
      "index": 5,
      "character_id": "princess",
      "expression": "sad",
      "text": "I miss you, Biscuit.",
      "line_audio": "aud_005",
      "sfx": [],
      "duration_ms": 1660,
      "animation": "speak"
    },
    {
      "index": 6,
      "character_id": "miss_moon",
      "expression": "surprised",
      "text": "Then — ding dong! And the king knocked on the princess's door.",
      "line_audio": "aud_006",
      "sfx": [
        {
          "audio": "sfx_chime",
          "at_ms": 920
        }
      ],
      "duration_ms": 3990,
      "animation": "speak"
    },
    {
      "index": 7,
      "character_id": "king",
      "expression": "happy",
      "text": "There is a delivery. You need to come downstairs to see the delivery.",
      "line_audio": "aud_007",
      "sfx": [],
      "duration_ms": 4750,
      "animation": "speak"
    },
    {
      "index": 8,
      "character_id": "miss_moon",
      "expression": "curious",
      "text": "The princess walked down the stairs, one step at a time.",
      "line_audio": "aud_008",
      "sfx": [],
      "duration_ms": 3520,
      "animation": "speak"
    },
    {
      "index": 9,
      "character_id": "miss_moon",
      "expression": "delighted",
      "text": "And there at the entrance stood a prince, holding Biscuit!",
      "line_audio": "aud_009",
      "sfx": [
        {
          "audio": "sfx_bark",
          "at_ms": 1990
        }
      ],
      "duration_ms": 3430,
      "animation": "speak"
    },
    {
      "index": 10,
      "character_id": "prince",
      "expression": "happy",
      "text": "I found her, and I brought her all the way home to you.",
      "line_audio": "aud_010",
      "sfx": [],
      "duration_ms": 3020,
      "animation": "speak"
    },
    {
      "index": 11,
      "character_id": "biscuit",
      "expression": "happy",
      "text": "Woof! Woof! Woof!",
      "line_audio": "aud_011",
      "sfx": [
        {
          "audio": "sfx_bark",
          "at_ms": 110
        }
      ],
      "duration_ms": 1557,
      "animation": "speak"
    },
    {
      "index": 12,
      "character_id": "princess",
      "expression": "happy",
      "text": "Biscuit! Oh, Biscuit, I'm so happy to see you!",
      "line_audio": "aud_012",
      "sfx": [],
      "duration_ms": 2810,
      "animation": "speak"
    },
    {
      "index": 13,
      "character_id": "miss_moon",
      "expression": "happy",
      "text": "And then the prince and princess married.",
      "line_audio": "aud_013",
      "sfx": [
        {
          "audio": "sfx_sparkle",
          "at_ms": 880
        }
      ],
      "duration_ms": 2210,
      "animation": "speak"
    },
    {
      "index": 14,
      "character_id": "miss_moon",
      "expression": "delighted",
      "text": "And Biscuit never, ever got lost again. The end.",
      "line_audio": "aud_014",
      "sfx": [
        {
          "audio": "sfx_chime",
          "at_ms": 1250
        }
      ],
      "duration_ms": 3500,
      "animation": "speak"
    }
  ],
