  "timeline": [
    {
      "index": 0,
      "character_id": "miss_moon",
      "expression": "delighted",
      "text": "In a green kingdom lived a brave knight named Sir Milo.",
      "line_audio": "aud_000",
      "sfx": [],
      "duration_ms": 3550,
      "animation": "speak"
    },
    {
      "index": 1,
      "character_id": "miss_moon",
      "expression": "surprised",
      "text": "One day a dragon carried Princess Rosa off to a dark mountain!",
      "line_audio": "aud_001",
      "sfx": [
        {
          "audio": "sfx_whoosh",
          "at_ms": 420
        }
      ],
      "duration_ms": 4030,
      "animation": "speak"
    },
    {
      "index": 2,
      "character_id": "knight",
      "expression": "angry",
      "text": "I will bring the princess home!",
      "line_audio": "aud_002",
      "sfx": [],
      "duration_ms": 1900,
      "animation": "speak"
    },
    {
      "index": 3,
      "character_id": "miss_moon",
      "expression": "curious",
      "text": "He traveled three days, over hills and rivers, to the mountain.",
      "line_audio": "aud_003",
      "sfx": [],
      "duration_ms": 3950,
      "animation": "speak"
    },
    {
      "index": 4,
      "character_id": "miss_moon",
      "expression": "curious",
      "text": "At the mouth of a cave, something was waiting…",
      "line_audio": "aud_004",
      "sfx": [],
      "duration_ms": 2860,
      "animation": "speak"
    },
    {
      "index": 5,
      "character_id": "dragon",
      "expression": "angry",
      "text": "Who dares enter MY mountain?",
      "line_audio": "aud_005",
      "sfx": [
        {
          "audio": "sfx_roar",
          "at_ms": 0
        }
      ],
      "duration_ms": 2290,
      "animation": "speak"
    },
    {
      "index": 6,
      "character_id": "princess",
      "expression": "scared",
      "text": "Sir Milo! Help me, please!",
      "line_audio": "aud_006",
      "sfx": [],
      "duration_ms": 1800,
      "animation": "speak"
    },
    {
      "index": 7,
      "character_id": "knight",
      "expression": "angry",
      "text": "Stand back, dragon!",
      "line_audio": "aud_007",
      "sfx": [
        {
          "audio": "sfx_shing",
          "at_ms": 270
        }
      ],
      "duration_ms": 2260,
      "animation": "speak"
    },
    {
      "index": 8,
      "character_id": "dragon",
      "expression": "angry",
      "layers": {
        "front_prop": "fire"
      },
      "text": "(breathes fire)",
      "line_audio": null,
      "sfx": [
        {
          "audio": "sfx_fire",
          "at_ms": 0
        }
      ],
      "duration_ms": 1800,
      "animation": "none"
    },
    {
      "index": 9,
      "character_id": "knight",
      "expression": "scared",
      "text": "Wait — why are you so angry?",
      "line_audio": "aud_009",
      "sfx": [],
      "duration_ms": 1910,
      "animation": "speak"
    },
    {
      "index": 10,
      "character_id": "dragon",
      "expression": "sad",
      "text": "No one ever visits. I am always alone.",
      "line_audio": "aud_010",
      "sfx": [],
      "duration_ms": 3120,
      "animation": "speak"
    },
    {
      "index": 11,
      "character_id": "knight",
      "expression": "happy",
      "layers": {
        "front_prop": null
      },
      "text": "Then let's be friends. Come to our kingdom!",
      "line_audio": "aud_011",
      "sfx": [],
      "duration_ms": 2630,
      "animation": "speak"
    },
    {
      "index": 12,
      "character_id": "princess",
      "expression": "happy",
      "text": "You're not so scary after all.",
      "line_audio": "aud_012",
      "sfx": [],
      "duration_ms": 1980,
      "animation": "speak"
    },
    {
      "index": 13,
      "character_id": "dragon",
      "expression": "happy",
      "text": "(a warm, rumbly laugh)",
      "line_audio": "aud_013",
      "sfx": [
        {
          "audio": "sfx_chime",
          "at_ms": 900
        }
      ],
      "duration_ms": 1910,
      "animation": "speak"
    },
    {
      "index": 14,
      "character_id": "miss_moon",
      "expression": "happy",
      "text": "So the dragon flew them home, and was never lonely again.",
      "line_audio": "aud_014",
      "sfx": [
        {
          "audio": "sfx_chime",
          "at_ms": 0
        }
      ],
      "duration_ms": 3450,
      "animation": "speak"
    }
  ],
