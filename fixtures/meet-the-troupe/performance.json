  "timeline": [
    {
      "index": 0,
      "character_id": "miss_moon",
      "expression": "delighted",
      "text": "Well hello there! I'm Miss Moon, and I am *so* happy you're here.",
      "line_audio": "aud_000",
      "sfx": [
        {
          "audio": "sfx_sparkle",
          "at_ms": 0
        }
      ],
      "duration_ms": 3720,
      "animation": "speak"
    },
    {
      "index": 1,
      "character_id": "miss_moon",
      "expression": "happy",
      "text": "This is Improv. You dream up a story and we act it out, right here",
      "line_audio": "aud_001",
      "sfx": [],
      "duration_ms": 4430,
      "animation": "speak"
    },
    {
      "index": 2,
      "character_id": "miss_moon",
      "expression": "curious",
      "text": "But your stories need actors! So let me introduce your improv troupe.",
      "line_audio": "aud_002",
      "sfx": [],
      "duration_ms": 4210,
      "animation": "speak"
    },
    {
      "index": 3,
      "character_id": "milo",
      "expression": "happy",
      "text": "I'm Milo. I play heroes, princes",
      "line_audio": "aud_005",
      "sfx": [],
      "duration_ms": 2830,
      "animation": "speak"
    },
    {
      "index": 4,
      "character_id": "milo",
      "expression": "neutral",
      "layers": {
        "headwear": "helmet",
        "front_prop": "sword"
      },
      "text": "and Sir Milo the Brave, who'll face any danger to tell YOUR story.",
      "line_audio": "aud_006",
      "sfx": [
        {
          "audio": "sfx_shing",
          "at_ms": 290
        }
      ],
      "duration_ms": 3920,
      "animation": "speak"
    },
    {
      "index": 5,
      "character_id": "bruno",
      "expression": "neutral",
      "text": "I'm Bruno! I play the kings, the giants, and the grumpy villains.",
      "line_audio": "aud_003",
      "sfx": [],
      "duration_ms": 4830,
      "animation": "speak"
    },
    {
      "index": 6,
      "character_id": "bruno",
      "expression": "angry",
      "text": "If someone's shouting, it's usually me.",
      "line_audio": "aud_004",
      "sfx": [],
      "duration_ms": 3210,
      "animation": "speak"
    },
    {
      "index": 7,
      "character_id": "ada",
      "expression": "happy",
      "text": "I'm Ada. I like to keep you guessing. Some days an astronaut.",
      "line_audio": "aud_007",
      "sfx": [],
      "duration_ms": 3850,
      "animation": "speak"
    },
    {
      "index": 8,
      "character_id": "ada",
      "expression": "neutral",
      "text": "Some days a wise queen.",
      "line_audio": "aud_014",
      "sfx": [],
      "duration_ms": 2000,
      "animation": "speak",
      "layers": {
        "headwear": "crown"
      }
    },
    {
      "index": 9,
      "character_id": "rosa",
      "expression": "happy",
      "text": "I'm Rosa.",
      "line_audio": "aud_008",
      "sfx": [],
      "duration_ms": 1360,
      "animation": "speak"
    },
    {
      "index": 10,
      "character_id": "rosa",
      "expression": "happy",
      "text": "If your story needs magic, I play the fairy!",
      "line_audio": "aud_015",
      "sfx": [
        {
          "audio": "sfx_sparkle",
          "at_ms": 0
        }
      ],
      "duration_ms": 2880,
      "animation": "speak",
      "layers": {
        "headwear": "tiara",
        "back_prop": "wings",
        "front_prop": "wand"
      }
    },
    {
      "index": 11,
      "character_id": "rosa",
      "expression": "angry",
      "text": "or I play the witch.",
      "line_audio": "aud_016",
      "sfx": [],
      "duration_ms": 1770,
      "animation": "speak",
      "layers": {
        "headwear": "witch_hat",
        "front_prop": "wand"
      }
    },
    {
      "index": 12,
      "character_id": "pip",
      "expression": "happy",
      "text": "I'm Pip. if it's small and fuzzy, that's me. A dog.",
      "line_audio": "aud_009",
      "sfx": [
        {
          "audio": "sfx_squeak",
          "at_ms": 2270
        }
      ],
      "duration_ms": 3280,
      "animation": "speak"
    },
    {
      "index": 13,
      "character_id": "pip",
      "expression": "neutral",
      "text": "or a cat,",
      "line_audio": "aud_017",
      "sfx": [],
      "duration_ms": 980,
      "animation": "speak",
      "layers": {
        "headwear": "whiskers"
      }
    },
    {
      "index": 14,
      "character_id": "pip",
      "expression": "surprised",
      "text": "or a rabbit!",
      "line_audio": "aud_018",
      "sfx": [],
      "duration_ms": 1310,
      "animation": "speak",
      "layers": {
        "headwear": "rabbit"
      }
    },
    {
      "index": 15,
      "character_id": "tuk",
      "expression": "happy",
      "text": "And I'm Tuk — the big one! A horse, a unicorn",
      "line_audio": "aud_010",
      "sfx": [],
      "duration_ms": 3060,
      "animation": "speak"
    },
    {
      "index": 16,
      "character_id": "tuk",
      "expression": "neutral",
      "layers": {
        "headwear": "horns"
      },
      "text": "and with a couple of horns",
      "line_audio": "aud_011",
      "sfx": [],
      "duration_ms": 1880,
      "animation": "speak"
    },
    {
      "index": 17,
      "character_id": "tuk",
      "expression": "angry",
      "layers": {
        "headwear": "horns",
        "front_prop": "fire"
      },
      "text": "a DRAGON!",
      "line_audio": "aud_013",
      "sfx": [
        {
          "audio": "sfx_fire",
          "at_ms": 0
        }
      ],
      "duration_ms": 1340,
      "animation": "speak"
    },
    {
      "index": 18,
      "character_id": "miss_moon",
      "expression": "delighted",
      "text": "That's the improv troupe! Now off you go and dream up a tale. I can't wait to see what stories you create. See you soon!",
      "line_audio": "aud_012",
      "sfx": [
        {
          "audio": "sfx_chime",
          "at_ms": 0
        }
      ],
      "duration_ms": 7480,
      "animation": "speak"
    }
  ],
